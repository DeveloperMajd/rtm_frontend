# Local dev defaults — point at the Sail backend on localhost. For a
# deployed environment (e.g. Vercel), override all of these with the real
# domains: see the project notes for the exact production values.
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000

# The Reverb *app key* is public by design (same as Pusher) — it identifies
# which app to connect to, not a secret. Safe to expose client-side; the
# REVERB_APP_SECRET on the backend is what actually authenticates.
VITE_REVERB_APP_KEY=emmgebjrgiuurwvjwx4p
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
